{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo no install: nothing here is built",
  "buildCommand": "echo no build: the pages come from the API",
  "outputDirectory": "site/public",
  "rewrites": [
    {
      "source": "/",
      "destination": "https://ask-production-fc5b.up.railway.app/"
    },
    {
      "source": "/terms",
      "destination": "https://ask-production-fc5b.up.railway.app/terms"
    },
    {
      "source": "/privacy",
      "destination": "https://ask-production-fc5b.up.railway.app/privacy"
    },
    {
      "source": "/licences",
      "destination": "https://ask-production-fc5b.up.railway.app/licences"
    },
    {
      "source": "/confamagent",
      "destination": "https://ask-production-fc5b.up.railway.app/confamagent"
    },
    {
      "source": "/confamagent/:path*",
      "destination": "https://ask-production-fc5b.up.railway.app/confamagent/:path*"
    },
    {
      "source": "/agent",
      "destination": "https://ask-production-fc5b.up.railway.app/agent"
    },
    {
      "source": "/agent/:path*",
      "destination": "https://ask-production-fc5b.up.railway.app/agent/:path*"
    },
    {
      "source": "/escrow/:id/proof",
      "destination": "https://ask-production-fc5b.up.railway.app/escrow/:id/proof"
    },
    {
      "source": "/media/:path*",
      "destination": "https://ask-production-fc5b.up.railway.app/media/:path*"
    }
  ]
}
