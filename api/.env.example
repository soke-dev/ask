# Copy to .env and fill in. Never commit .env.

# ── Database ────────────────────────────────────────────────────────────────
# From Railway: Postgres service → Variables → DATABASE_PUBLIC_URL while you
# are running the API on your laptop. Switch to DATABASE_URL once the API is
# deployed alongside it, so traffic stays on Railway's private network.
DATABASE_URL=

# ── Vision ──────────────────────────────────────────────────────────────────
# Optional. Without it the relevance check reports itself as skipped and
# everything else still runs.
ANTHROPIC_API_KEY=
VISION_MODEL=claude-sonnet-5

# ── Server ──────────────────────────────────────────────────────────────────
PORT=8080

# Development only — Railway wipes the container filesystem on every deploy,
# so this must become an object store (R2/S3) before the API is hosted.
STORAGE_DRIVER=disk
STORAGE_DIR=.uploads

# ── Check thresholds ────────────────────────────────────────────────────────
# Starting values, not measured ones. Run `npm run checks:try` to see how they
# behave, and expect to move them once real submissions exist.

# Laplacian variance on a 640px greyscale copy. Higher is sharper.
SHARPNESS_RETAKE_BELOW=40
SHARPNESS_WARN_BELOW=90

# Mean luma, 0-255.
EXPOSURE_DARK_RETAKE_BELOW=22
EXPOSURE_DARK_WARN_BELOW=45
EXPOSURE_BRIGHT_WARN_ABOVE=225
EXPOSURE_CLIPPED_WARN_ABOVE=0.45

# Distance from the pin. Advisory only — never rejects a submission.
GEO_NEAR_METRES=150
GEO_FAR_METRES=600

# Media limits.
MAX_UPLOAD_BYTES=41943040
MAX_PHOTOS=5
MAX_VIDEO_SECONDS=30
MIN_VIDEO_SECONDS=2
VIDEO_FRAMES_SAMPLED=3

# Retakes allowed before the job returns to the pool.
MAX_SUBMISSION_ATTEMPTS=3

# ── Gasless withdrawals ──────────────────────────────────────────────────────
# The account that pays gas on Base so users never need ETH.
#
# Withdrawals use EIP-3009: the person signs an authorisation off-chain and
# this key submits it, paying the fee. It needs a small ETH balance on Base and
# never holds USDC — it relays, it does not custody.
#
# 0x-prefixed, 64 hex characters. Server-side only: never prefix it
# EXPO_PUBLIC_, which would compile it into the app for anyone to read.
GAS_WALLET_PRIVATE_KEY=

# Refuse to relay when the gas wallet drops below this many ETH.
MIN_GAS_WALLET_ETH=0.0002
