{
  "expo": {
    "name": "Confam",
    "slug": "ask-nearby",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "confam",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FF6B00"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "xyz.confam.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "2"
    },
    "android": {
      "package": "xyz.confam.app",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FF6B00"
      }
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Ask Nearby uses the camera so you can photograph or film what you were sent to check, and to set your profile picture.",
          "microphonePermission": "Ask Nearby records audio with your video so you can say the date and describe what you are seeing.",
          "photosPermission": "Ask Nearby opens your library only so you can choose a profile picture. Job evidence is always taken with the camera."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Ask Nearby uses your location to confirm you reached the place you were sent to check."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Ask Nearby uses the camera so you can photograph or film what you were sent to check, set your profile picture, and scan a wallet QR code when you withdraw.",
          "microphonePermission": "Ask Nearby records audio with your video so you can say the date and describe what you are seeing.",
          "recordAudioAndroid": false
        }
      ],
      "expo-secure-store",
      "expo-video",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#FF6B00"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "60e34308-3190-4583-8c6e-0100e0d93646"
      }
    },
    "owner": "moversdigital",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/60e34308-3190-4583-8c6e-0100e0d93646"
    }
  }
}
