# ── Deploying AskEscrow to Base ─────────────────────────────────────────────
# Copy to .env and fill in. Never commit .env — it is gitignored.

# Pays for the deployment. Needs a little ETH on Base.
# Becomes the owner momentarily, then hands ownership to OWNER_ADDRESS.
DEPLOYER_PRIVATE_KEY=

# Can upgrade the contract, change the fee, and replace the arbiter.
# This is the most powerful key in the system: it can rewrite the rules
# governing money that is already escrowed. A Safe multisig belongs here.
OWNER_ADDRESS=

# Rules on disputed jobs. Nothing else. The backend holds this key so it can
# submit resolutions, which means it lives on a server — and is exactly why it
# must not also be the owner.
ARBITER_ADDRESS=

# Receives the 10% platform share of every settled job and tip.
TREASURY_ADDRESS=

# 1_000 = 10%. Changeable later by the owner, capped at 2_000 (20%).
FEE_BPS=1000

# Circle's USDC on Base mainnet. Only change this for a testnet deploy.
USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# For publishing the source on BaseScan, so anyone can read what they are
# trusting. Free key from basescan.org/myapikey.
BASESCAN_API_KEY=

BASE_RPC_URL=https://mainnet.base.org
